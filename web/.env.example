# Public Privy app id (safe to expose)
NEXT_PUBLIC_PRIVY_APP_ID=
# "testnet" or "mainnet"
NEXT_PUBLIC_NETWORK=
# Server-only. From the Privy dashboard. Never commit.
PRIVY_APP_SECRET=
# Server-only. Must be the escrow's inviteSigner. Never commit.
INVITE_SIGNER_PRIVATE_KEY=
# Supabase project URL (public)
NEXT_PUBLIC_SUPABASE_URL=
# Server-only. Supabase secret key, sb_secret_... Never import in client code. Never commit.
SUPABASE_SERVICE_ROLE_KEY=
# Public "world is flat crowd" group id (1 on testnet)
NEXT_PUBLIC_PUBLIC_GROUP_ID=
# Public app URL, printed on share cards (e.g. https://betyouwont.app)
NEXT_PUBLIC_APP_URL=

# Legal pages: contact email shown on /terms, /privacy, /guidelines and the footer.
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
# Server-only: comma-separated wallet addresses that can open /admin (report review, blocks, deletion).
ADMIN_WALLETS=
# Server-only: Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/cleanup (daily). Long random value.
CRON_SECRET=
